# ==============================================================================
# Environment Configuration - LinguaColombia AI Customer Support System
# ==============================================================================

# OpenAI API Key (Optional - Get your key from https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (Optional - Get your free key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Semantic Similarity Threshold for Out-of-Scope Detection (0.10 to 0.45)
SIMILARITY_THRESHOLD=0.22

# Server Configuration
PORT=8000
HOST=0.0.0.0
